# ─────────────────────────────────────────────────────────────
# The Digital Engine — HQ dashboard
# Copy this file to `.env.local` and fill in the values.
# Every value is OPTIONAL: with none set, the dashboard renders
# the pre-revenue seed/empty state (identical to the design
# prototype). Fill a database ID to make that section live.
# ─────────────────────────────────────────────────────────────

# Internal Notion integration secret (server-side only, read-only is fine).
# Create at https://www.notion.so/my-integrations
NOTION_TOKEN=

# One database ID per Notion database (the 32-char hash in the DB URL).
# Share each database with the integration: ••• → Connections → add it.
NOTION_DB_CLIENTS=
NOTION_DB_PIPELINE=
NOTION_DB_BUILDS=
NOTION_DB_SUBSCRIPTIONS=
NOTION_DB_INVOICES=
NOTION_DB_TASKS=
NOTION_DB_MEETINGS=
NOTION_DB_CONTENT=
NOTION_DB_SERVICES=
NOTION_DB_GOALS=

# App config (optional). Accent must be one of the design's five options:
# #5b8def (blue) · #9fd6c0 (sage) · #c6aee0 (lilac) · #e8b6a0 (peach) · #e88f8f (rose)
NEXT_PUBLIC_ACCENT=#5b8def
NEXT_PUBLIC_FOUNDER_NAME=Croíadh

# Optional real Notion page URLs for the "Jump to" and "SOPs & Templates" chips.
# Leave blank to render them as non-links.
NEXT_PUBLIC_LINK_CLIENTS_HUB=
NEXT_PUBLIC_LINK_PROJECTS=
NEXT_PUBLIC_LINK_CLIENT_FINANCES=
NEXT_PUBLIC_LINK_KNOWLEDGE_BASE=
NEXT_PUBLIC_LINK_SOCIAL_MEDIA=
NEXT_PUBLIC_LINK_DOCS=
