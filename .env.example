# ─────────────────────────────────────────────────────────────
# The Digital Engine — HQ dashboard
# Copy this file to `.env.local` and fill in the values.
# Every value is OPTIONAL: with none set, the dashboard renders
# the pre-revenue seed/empty state (identical to the design
# prototype). Fill a database ID to make that section live.
# ─────────────────────────────────────────────────────────────

# Internal Notion integration secret (server-side only, read-only is fine).
# Create at https://www.notion.so/my-integrations
NOTION_TOKEN=

# One database ID per Notion database (the 32-char hash in the DB URL).
# Share each database with the integration: ••• → Connections → add it.
NOTION_DB_CLIENTS=
NOTION_DB_PIPELINE=
NOTION_DB_BUILDS=
NOTION_DB_SUBSCRIPTIONS=
NOTION_DB_INVOICES=
NOTION_DB_TASKS=
NOTION_DB_MEETINGS=
NOTION_DB_CONTENT=
NOTION_DB_SERVICES=
NOTION_DB_GOALS=

# App config (optional). Accent must be one of the design's five options:
# #5b8def (blue) · #9fd6c0 (sage) · #c6aee0 (lilac) · #e8b6a0 (peach) · #e88f8f (rose)
NEXT_PUBLIC_ACCENT=#5b8def
NEXT_PUBLIC_FOUNDER_NAME=Croíadh

# Optional real Notion page URLs for the "Jump to" and "SOPs & Templates" chips.
# Leave blank to render them as non-links.
NEXT_PUBLIC_LINK_CLIENTS_HUB=
NEXT_PUBLIC_LINK_PROJECTS=
NEXT_PUBLIC_LINK_CLIENT_FINANCES=
NEXT_PUBLIC_LINK_KNOWLEDGE_BASE=
NEXT_PUBLIC_LINK_SOCIAL_MEDIA=
NEXT_PUBLIC_LINK_DOCS=

# ─────────────────────────────────────────────────────────────
# Life OS  (/life)
# ─────────────────────────────────────────────────────────────
# All optional. With none set, /life still works fully — it just runs
# local-to-this-browser, with no calendar and no business panels.
#
# NOTE: this repository is PUBLIC. Never put real IDs, tokens or calendar
# URLs in this file — it is committed. Real values belong in .env.local
# (git-ignored) and in the Vercel project's environment variables.

# Notion databases, all under "Croí — Command Centre".
# The 32-char hash from each database's URL. Share each one with the same
# integration as NOTION_TOKEN (••• → Connections).
NOTION_DB_LIFE_ITEMS=      # 🧠 Life OS — Inbox           (read + write: the sync target)
NOTION_DB_SESSIONS=        # 🤖 Claude Sessions — Status  (read only)
NOTION_DB_PROJECTS=        # 🗂️ Projects & Delivery       (read only)

# Google Calendar, read-only, via each calendar's *secret* iCal address:
#   Google Calendar → Settings → (pick calendar) → "Secret address in iCal format"
# Comma-separated, each entry "Label|https://…". The label is what shows next
# to each event in the app.
#
# ⚠️  Treat these URLs like passwords — anyone holding one can read that whole
#     calendar. They stay server-side; the browser never sees them.
LIFE_ICS_URLS=             # e.g. Work|https://calendar.google.com/calendar/ical/…/basic.ics,Personal|https://…
